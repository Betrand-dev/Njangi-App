{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/signup.jsx",
    "app/login.jsx",
    "app/index.jsx",
    "app/home/index.jsx",
    "app/(onboarding)/index.jsx",
    "nativewind-env.d.ts"
  ]
}